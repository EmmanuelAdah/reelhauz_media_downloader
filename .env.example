# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://videos.example.com
# DJANGO_SECURE_COOKIES=True        # enable when served over HTTPS
# DJANGO_BEHIND_PROXY=True          # trust X-Forwarded-Proto from your reverse proxy

# --- Database (PostgreSQL): holds accounts and "where you stopped watching" only. No videos. ---
DATABASE_URL=postgres://video_user:video_pass@localhost:5432/video_downloader

# --- Redis: Celery broker + live job state + rate limits (job state is deleted after delivery) ---
REDIS_URL=redis://localhost:6379/0
# CELERY_ALWAYS_EAGER=True          # run downloads inline in the request (dev only, no live progress)

# --- Temporary staging folder (shared by web + worker). Files are deleted once the user has saved them. ---
DOWNLOAD_TMP_DIR=tmp_downloads

# --- Limits ---
MAX_DOWNLOAD_SIZE_MB=1024
MAX_VIDEO_DURATION_SECONDS=10800
MAX_CONCURRENT_DOWNLOADS=5         # server-wide
TRANSFER_TTL_SECONDS=3600          # undelivered files are purged after this
QUEUE_TIMEOUT_SECONDS=90           # fail a job no worker picked up
RATE_LIMIT_METADATA=10             # per user (or IP when anonymous), per minute
RATE_LIMIT_DOWNLOAD=3
# TRUSTED_PROXY_COUNT=1            # number of reverse proxies, so real client IPs are used
# YTDLP_COOKIES_FILE=/path/to/cookies.txt   # optional: for age-gated / bot-checked videos
# YTDLP_COOKIES_FROM_BROWSER=firefox      # running locally? let yt-dlp use your browser's YouTube login (firefox, chrome, chrome:Profile 1)
# YTDLP_PLAYER_CLIENTS=tv,tv_downgraded     # pin YouTube clients (default: automatic fallback when YouTube shows a bot check)
# YTDLP_PROXY=http://user:pass@host:port    # route YouTube traffic through another IP (home/residential works best)
# YTDLP_JS_RUNTIME=deno                     # deno | node | bun | quickjs (auto-detected when empty)
